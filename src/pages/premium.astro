    color: var(--color-muted);
  }

  .p-honey-media {
    overflow: hidden;
  }

  /* Mișcare: totul pornește doar cu clasa .motion, pusă din script când utilizatorul nu a cerut mișcare redusă */
  :root {
    --ease-out: cubic-bezier(0.16, 1, 0.3, 1);
    --ease-wipe: cubic-bezier(0.77, 0, 0.18, 1);
  }
  .p-line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.1em;
    margin-bottom: -0.1em;
  }
  .p-line > span {
    display: block;
  }
  .motion .p-hero-img {
    animation: p-zoom 2.8s var(--ease-out) both;
  }
  .motion .p-line > span {
    animation: p-rise 1.2s var(--ease-out) var(--d, 0ms) both;
  }
  .motion .p-in {
    animation: p-fade 1s var(--ease-out) var(--d, 0ms) both;
  }
  @keyframes p-zoom {
    from {
      transform: scale(1.14);
      filter: brightness(0.6);
    }
  }
  @keyframes p-rise {
    from {
      transform: translateY(105%);
    }
  }
  @keyframes p-fade {
    from {
      opacity: 0;
      transform: translateY(18px);
