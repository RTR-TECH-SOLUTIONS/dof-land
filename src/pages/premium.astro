---
// Varianta „premium” a paginii principale, pentru comparat cu cea de la /.
import { getImage, Image } from 'astro:assets';
import honeyLabel from '../assets/brand/eticheta-miere.png';
import Layout from '../layouts/Layout.astro';
import { schoolPackages } from '../data/garden';
import { img, products } from '../data/products';
import { lei, site, u } from '../data/site';

const pick = (slugs: string[]) => slugs.map((s) => products.find((p) => p.slug === s)!);
const lavender = await Promise.all(
  pick(['set-3-saculeti-lavanda-50g', 'set-5-saculeti-lavanda-30g', 'lumanare-cu-lavanda', 'sapun-cu-lavanda']).map(async (p) => ({
    ...p,
    thumb: (await getImage({ src: img(p.image), width: 160, height: 160, fit: 'cover' })).src,
  })),
);
const gifts = pick(['set-cadou-miere-lavanda', 'set-cadou-lavanda', 'set-cadou-diverse-produse']);
---

<Layout title="Dof Land | Un colț de rai la Poienarii Burchii" variant="premium">
  <section class="p-hero">
    <div class="p-hero-media" data-parallax="0.25">
      <Image src={img('lan-hero')} alt="Rânduri de lavandă înflorită la apus" width={1800} height={1200} fit="cover" loading="eager" fetchpriority="high" class="p-hero-img" />
    </div>
    <div class="p-hero-text">
      <p class="p-kicker p-kicker-hero p-in" style="--d: 300ms">Poienarii Burchii, Prahova</p>
      <h1>
        <span class="p-line"><span style="--d: 450ms">Lavandă, miere și căpșuni</span></span>
        <span class="p-line"><span style="--d: 600ms">din grădina noastră</span></span>
      </h1>
      <p class="p-hero-lead p-in" style="--d: 900ms">Le cultivăm pe 5000 de metri pătrați și le trimitem acasă prin {site.courier}.</p>
      <div class="p-actions p-in" style="--d: 1050ms">
        <a href={u('/magazin')} class="p-btn p-btn-gold">Intră în magazin</a>
        <a href={u('/gradina-educativa')} class="p-btn p-btn-line">Vizitează grădina</a>
      </div>
    </div>
  </section>

  <section class="p-dark">
    <div class="p-wrap p-intro">
      <h2 data-split>Un colț de rai, făcut cu mâinile noastre</h2>
      <p data-reveal style="--d: 400ms">
        Cultivăm căpșuni, lavandă, trandafiri, lalele și plante aromatice. Lavanda o tăiem vara și o uscăm la umbră, apoi umplem
        săculeții unul câte unul.
      </p>
    </div>
  </section>

  <section class="p-light">
    <div class="p-wrap">
      <div class="p-head" data-reveal>
        <h2>Colecția de lavandă</h2>
        <a href={u('/magazin?categorie=lavanda')} class="p-more">Toate produsele cu lavandă</a>
      </div>
      <div class="p-grid">
        {
          lavender.map((p, i) => (
            <article class="p-card" data-reveal style={`--d: ${i * 120}ms`}>
              <a href={u(`/produs/${p.slug}`)} class="p-card-img">
                <Image src={img(p.image)} alt={p.name} width={600} height={750} fit="cover" loading="lazy" />
              </a>
              <h3><a href={u(`/produs/${p.slug}`)}>{p.name}</a></h3>
              <p class="p-price">{lei(p.price)}</p>
              <button type="button" class="p-add" data-add data-id={p.slug} data-name={p.name} data-price={p.price} data-img={p.thumb}>
                Adaugă în coș
              </button>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="p-honey">
    <div class="p-honey-media" data-reveal="wipe">
      <Image src={img('miere-borcan')} alt="Borcan de miere cu linguriță de lemn, între flori de cireș" width={1000} height={1250} fit="cover" loading="lazy" class="p-honey-photo" />
    </div>
    <div class="p-honey-text" data-reveal>
      <Image src={honeyLabel} alt="Eticheta mierii polifloră Dof Land" width={260} height={260} loading="lazy" class="p-honey-label" />
      <h2>Miere polifloră</h2>
      <p>Gust dulce și aromă florală, pentru micul dejun, ceai sau deserturi.</p>
      <dl>
        <div><dt>Borcan de 380 ml</dt><dd>29,99 lei</dd></div>
        <div><dt>Borcan de 200 ml</dt><dd>18,99 lei</dd></div>
      </dl>
      <a href={u('/produs/miere-poliflora-380ml')} class="p-btn p-btn-gold">Comandă mierea</a>
    </div>
  </section>

  <section class="p-cream">
    <div class="p-wrap">
      <div class="p-head" data-reveal>
        <h2>Seturi cadou</h2>
        <a href={u('/magazin?categorie=cadouri')} class="p-more">Toate seturile</a>
      </div>
      <div class="p-gifts">
        {
          gifts.map((g, i) => (
            <a href={u(`/produs/${g.slug}`)} class:list={['p-gift', i === 0 && 'p-gift-main']} data-reveal="wipe" style={`--d: ${i * 150}ms`}>
              <Image src={img(g.image)} alt="" width={i === 0 ? 1000 : 600} height={i === 0 ? 1000 : 600} fit="cover" loading="lazy" />
              <div>
                <h3>{g.name}</h3>
                <p>{g.priceFrom && 'de la '}{lei(g.price)}</p>
              </div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="p-dark">
    <div class="p-wrap p-garden">
      <div class="p-garden-photos" data-reveal="wipe">
        <Image src={img('masa-lavanda-client')} alt="Masă cu față de masă cu lavandă, coș cu lavandă uscată și dovleci" width={800} height={1000} fit="cover" loading="lazy" />
        <Image src={img('atelier-masa-client')} alt="Copii care plantează răsaduri de căpșun la masa de lucru" width={600} height={600} fit="cover" loading="lazy" />
      </div>
      <div>
        <p class="p-kicker" data-reveal>Din aprilie până în octombrie</p>
        <h2 data-split>Grădina educativă</h2>
        <p class="p-muted" data-reveal style="--d: 200ms">
          Primim grădinițe, școli și familii. Copiii plantează, observă insectele și semințele și pleacă acasă cu ghiveciul lor.
        </p>
        <ul class="p-packages">
          {schoolPackages.map((p, i) => <li data-reveal style={`--d: ${250 + i * 90}ms`}><span>{p.name}</span><span>{p.duration}</span><b>{p.price} lei</b></li>)}
        </ul>
        <div class="p-actions">
          <a href={u('/gradina-educativa#oferta')} class="p-btn p-btn-gold">Cere ofertă pentru grup</a>
          <a href={u('/evenimente')} class="p-btn p-btn-line">Evenimente 2027</a>
        </div>
      </div>
    </div>
  </section>

  <section class="p-visit">
    <div class="p-visit-media" data-parallax="0.18">
      <Image src={img('lan-aproape')} alt="Spice de lavandă în lan" width={1800} height={1200} fit="cover" loading="lazy" class="p-visit-img" />
    </div>
    <div class="p-visit-box" data-reveal>
      <h2>Vă așteptăm la grădină</h2>
      <dl>
        {site.schedule.map((s) => <div><dt>{s.days}</dt><dd>{s.hours}</dd></div>)}
      </dl>
      <a href={u('/viziteaza-ne')} class="p-btn p-btn-dark">Cum ajungeți</a>
    </div>
  </section>
</Layout>


<script is:inline>
  // Pus înainte de prima randare, ca elementele să nu apară și apoi să dispară
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
</script>

<script>
  import Lenis from 'lenis';
  import 'lenis/dist/lenis.css';

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Titlurile cu data-split se împart în cuvinte, fiecare urcă din spatele unei măști
  document.querySelectorAll<HTMLElement>('[data-split]').forEach((el) => {
    const words = el.textContent!.trim().split(/\s+/);
    el.setAttribute('aria-label', words.join(' '));
    el.innerHTML = words
      .map((w, i) => `<span class="w" aria-hidden="true"><span style="--i:${i}">${w}</span></span>`)
      .join(' ');
  });

  if (!reduce) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          // și ce e deja deasupra ecranului (revenire în pagină, salt la ancoră)
          if (!e.isIntersecting && e.boundingClientRect.top > 0) continue;
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      },
      { rootMargin: '0px 0px -12% 0px' },
    );
    document.querySelectorAll('[data-reveal], [data-split]').forEach((el) => io.observe(el));

    const lenis = new Lenis({ lerp: 0.09 });
    const layers = [...document.querySelectorAll<HTMLElement>('[data-parallax]')];
    const frame = (t: number) => {
      lenis.raf(t);
      for (const el of layers) {
        const box = el.parentElement!.getBoundingClientRect();
        if (box.bottom < 0 || box.top > innerHeight) continue;
        el.style.transform = `translate3d(0, ${-box.top * Number(el.dataset.parallax)}px, 0)`;
      }
      requestAnimationFrame(frame);
    };
    requestAnimationFrame(frame);
  }
</script>

<style is:global>
  body.premium {
    background: var(--color-night);
  }
  .p-wrap {
    max-width: 1320px;
    margin-inline: auto;
