---
import { getImage, Image } from 'astro:assets';
import ProductCard from '../../components/ProductCard.astro';
import Layout from '../../layouts/Layout.astro';
import { categoryName, img, products, type Product } from '../../data/products';
import { lei, site, u, waLink } from '../../data/site';

export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
const thumb = await getImage({ src: img(product.image), width: 160, height: 160, fit: 'cover' });
const related = products.filter((p) => p.slug !== product.slug && p.category === product.category).slice(0, 4);
const similar = related.length >= 2 ? related : products.filter((p) => p.slug !== product.slug && p.bestseller).slice(0, 4);
---

<Layout title={`${product.name} | Dof Land`} description={product.short}>
  <div class="wrap py-6 text-[0.94rem] text-muted">
    <nav aria-label="Ești aici">
      <a href={u('/magazin')} class="hover:text-lav underline underline-offset-4">Magazin</a>
      <span aria-hidden="true"> / </span>
      <a href={u(`/magazin?categorie=${product.category}`)} class="hover:text-lav underline underline-offset-4">{categoryName(product.category)}</a>
    </nav>
  </div>

  <section class="wrap grid gap-8 pb-16 md:grid-cols-2 md:gap-14">
    <Image
      src={img(product.image)}
      alt={product.name}
      width={1000}
      height={1000}
      fit="cover"
      loading="eager"
      class="aspect-square w-full rounded-[10px] bg-cream object-cover"
    />

    <div>
      <h1 class="!text-[clamp(1.5rem,2.6vw,2rem)]">{product.name}</h1>
      <p class="mt-4 flex items-baseline gap-3">
        <span class="text-[1.7rem] font-bold text-lav">{lei(product.price)}</span>
        {product.oldPrice && <s class="text-muted">{lei(product.oldPrice)}</s>}
        <span class="text-muted">/ {product.unit}</span>
      </p>
      <p class="lead mt-4">{product.short}</p>

      <div class="mt-7 flex flex-wrap items-end gap-3">
        <div>
          <label class="label" for="qty">Cantitate</label>
          <input id="qty" type="number" min="1" max="50" value="1" inputmode="numeric" class="field !w-24" />
        </div>
        <button
          type="button"
          class="btn flex-1 min-w-[200px]"
          data-add
          data-qty-from="#qty"
          data-id={product.slug}
          data-name={product.name}
          data-price={product.price}
          data-img={thumb.src}
        >
          Adaugă în coș
        </button>
      </div>
      <p class="mt-4">
        <a class="link" href={waLink(`Bună ziua! Am o întrebare despre „${product.name}”.`)} target="_blank" rel="noopener">
          Întrebați-ne pe WhatsApp
        </a>
      </p>

      <dl class="mt-8 divide-y divide-line border-y border-line">
        <div class="flex gap-4 py-3.5">
          <dt class="w-28 flex-none font-bold">Livrare</dt>
          <dd>
            {
              product.pickupOnly
                ? 'Acest produs se ridică de la grădină, nu se trimite prin curier.'
                : `Prin curier, în 1 - 3 zile lucrătoare. Gratuită peste ${site.freeShippingFrom} lei.`
            }
          </dd>
        </div>
        <div class="flex gap-4 py-3.5">
          <dt class="w-28 flex-none font-bold">Plată</dt>
          <dd>Ramburs, la primirea coletului.</dd>
        </div>
        <div class="flex gap-4 py-3.5">
          <dt class="w-28 flex-none font-bold">Retur</dt>
          <dd>În 14 zile de la primire.</dd>
        </div>
      </dl>

      <h2 class="mt-8">Despre produs</h2>
      {product.description.map((p) => <p class="mt-4 max-w-[62ch]">{p}</p>)}
      <ul class="mt-6 space-y-2.5">
        {product.details.map((d) => <li class="check">{d}</li>)}
      </ul>
    </div>
  </section>

  <section class="section bg-cream">
    <div class="wrap">
      <h2>S-ar putea să vă placă</h2>
      <div class="mt-6 grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-6">
        {similar.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>
</Layout>
