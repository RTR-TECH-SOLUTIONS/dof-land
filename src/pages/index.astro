---
import { Image } from 'astro:assets';
import honeyLabel from '../assets/brand/eticheta-miere.png';
import ProductCard from '../components/ProductCard.astro';
import Layout from '../layouts/Layout.astro';
import { schoolPackages } from '../data/garden';
import { categories, img, products } from '../data/products';
import { lei, site, u } from '../data/site';

const bestsellers = products.filter((p) => p.bestseller).slice(0, 4);
const garden = ['rasad-muscate', 'rasad-petunii', 'plante-aromatice-mix-6', 'leandru-ghiveci-25cm'].map((slug) => products.find((p) => p.slug === slug)!);
---

<Layout title="Dof Land | Lavandă, miere și grădină educativă în Prahova">
  <section class="wrap pt-4 md:pt-6">
    <div class="hero">
      <a href={u('/magazin?categorie=lavanda')} class="hero-main">
        <Image src={img('saculeti-client')} alt="Săculeți cu lavandă Dof Land, lângă un coș cu lavandă uscată" width={1100} height={1100} fit="cover" position="bottom" loading="eager" fetchpriority="high" />
        <div class="hero-text">
          <p class="hero-kicker">Din grădina noastră, Poienarii Burchii</p>
          <h1>Săculeți cu lavandă, de la 12,99 lei</h1>
          <p class="mt-2 max-w-[34ch]">Set de 3 săculeți de 50 g sau de 5 săculeți de 30 g, pentru dulapuri și sertare.</p>
          <span class="btn btn-gold mt-6">Cumpără acum</span>
        </div>
      </a>
      <a href={u('/magazin?categorie=capsuni')} class="hero-side">
        <Image src={img('capsuni')} alt="Căpșună coaptă pe plantă" width={700} height={400} fit="cover" loading="eager" />
        <div>
          <h2>Căpșuni, cultura noastră principală</h2>
          <p>Stoloni Donna și Aprica, 3,50 lei bucata</p>
        </div>
      </a>
      <a href={u('/gradina-educativa')} class="hero-side">
        <Image src={img('atelier-masa-client')} alt="Copii care plantează răsaduri de căpșun la masa de lucru" width={700} height={400} fit="cover" loading="eager" />
        <div>
          <h2>Ateliere pentru copii și evenimente</h2>
          <p>Grădinițe, școli, zile de naștere</p>
        </div>
      </a>
    </div>

    <ul class="trust">
      <li><b>Livrare {site.courier}</b> {lei(site.shippingCost)}</li>
      <li><b>Plata ramburs</b> la curier</li>
      <li><b>Retur</b> în 14 zile</li>
      <li><b>Din grădina noastră</b> de la Poienarii Burchii</li>
    </ul>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head"><h2>Categorii</h2></div>
      <ul class="grid grid-cols-3 gap-x-4 gap-y-6 md:gap-x-8 lg:grid-cols-6">
        {
          categories.map((c) => (
            <li>
              <a href={u(`/magazin?categorie=${c.slug}`)} class="cat">
                <Image src={img(c.image)} alt="" width={360} height={360} fit="cover" loading="lazy" />
                <span>{c.name}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section !pt-0">
    <div class="wrap">
      <div class="section-head">
        <h2>Cele mai vândute</h2>
        <a href={u('/magazin')} class="link">Vezi toate produsele</a>
      </div>
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-6">
        {bestsellers.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="honey">
    <div class="wrap honey-inner">
      <Image src={honeyLabel} alt="Eticheta mierii polifloră Dof Land" width={520} height={520} loading="lazy" class="honey-label" />
      <div>
        <p class="hero-kicker">Produse apicole</p>
        <h2>Miere polifloră Dof Land</h2>
        <p class="mt-3 max-w-[46ch] text-white/80">
          Gust dulce și aromă florală, pentru micul dejun, ceai sau deserturi. În borcan de 380 ml sau de 200 ml.
        </p>
        <dl class="honey-prices">
          <div><dt>380 ml</dt><dd>29,99 lei</dd></div>
          <div><dt>200 ml</dt><dd>18,99 lei</dd></div>
        </dl>
        <div class="mt-7 flex flex-wrap gap-3">
          <a href={u('/produs/miere-poliflora-380ml')} class="btn btn-gold">Comandă mierea</a>
          <a href={u('/magazin?categorie=miere')} class="btn btn-ghost">Toate produsele apicole</a>
        </div>
      </div>
    </div>
  </section>

  <section class="wrap section !pb-0">
    <a href={u('/produs/set-cadou-miere-lavanda')} class="promo">
      <Image src={img('set-cadou')} alt="Set cadou cu miere și produse cu lavandă" width={640} height={420} fit="cover" loading="lazy" />
      <div>
        <p class="promo-tag">Seturi cadou</p>
        <h2>Miere, săculeț, lumânare și săpun, într-un singur set</h2>
        <p class="mt-2">Setul cu miere de 200 ml și linguriță, 49,99 lei. Fără miere, 29,99 lei.</p>
        <span class="btn mt-4">Vezi setul</span>
      </div>
    </a>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="section-head">
        <h2>Pentru grădină și balcon</h2>
        <a href={u('/magazin?categorie=flori-si-plante')} class="link">Toate florile și plantele</a>
      </div>
      <div class="grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-4 md:gap-x-6">
        {garden.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <section class="section bg-cream border-y border-line">
    <div class="wrap edu">
      <div class="edu-photos">
        <Image src={img('atelier-cos-client')} alt="Stropitoare, coș de răchită și ghivece pe masa de atelier" width={760} height={570} fit="cover" loading="lazy" />
        <Image src={img('masa-lavanda-client')} alt="Masă cu față de masă cu lavandă, coș cu lavandă uscată și dovleci" width={420} height={520} fit="cover" loading="lazy" />
        <Image src={img('cosuri-client')} alt="Felinar de răchită și coș cu lavandă uscată" width={420} height={520} fit="cover" loading="lazy" />
      </div>
      <div>
        <h2 class="!text-[clamp(1.5rem,2.6vw,2rem)]">Grădina educativă Dof Land</h2>
        <p class="mt-3">
          Primim grupuri de la grădinițe și școli, din aprilie până în octombrie. Copiii plantează, observă insectele și semințele și pleacă acasă cu ceva făcut de mâna lor.
        </p>
        <table class="edu-table">
          <tbody>
            {schoolPackages.map((p) => <tr><th>{p.name}</th><td>{p.duration}</td><td>de la {p.price} lei / elev</td></tr>)}
          </tbody>
        </table>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={u('/gradina-educativa#oferta')} class="btn">Cere ofertă pentru grup</a>
          <a href={u('/evenimente')} class="btn btn-outline">Evenimente 2027</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="poveste">
    <div class="wrap story">
      <div>
        <h2 class="!text-[clamp(1.5rem,2.6vw,2rem)]">Povestea noastră</h2>
        <p class="mt-3">
          Dof Land s-a născut din dorința de a crea un loc în care natura, educația și bucuria lucrurilor simple să se întâlnească. Este un proiect de suflet, construit pas cu pas pe 5000 de metri pătrați, la Poienarii Burchii, județul Prahova.
        </p>
        <p class="mt-3">
          Locul a fost amenajat special pentru activitățile cu copii, iar restul l-am dezvoltat în jurul lor. Astăzi cultivăm căpșuni, lavandă, trandafiri, lalele, plante aromatice și flori de sezon.
        </p>
        <p class="mt-3">
          Credem că fiecare floare, fiecare plantă și fiecare produs spune o poveste. De aceea, tot ceea ce oferim poartă amprenta muncii noastre și a grijii pentru calitate.
        </p>
        <p class="mt-4"><a href={u('/viziteaza-ne')} class="link">Program de vizitare și cum ajungeți</a></p>
      </div>
      <Image src={img('buchete-client')} alt="Buchete de lavandă uscată în coș de răchită" width={900} height={520} fit="cover" loading="lazy" />
    </div>
  </section>
</Layout>

<style is:global>
  .hero {
    display: grid;
    gap: 12px;
  }
  .hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero-main {
    display: grid;
    background: var(--color-night);
    color: rgb(255 255 255 / 0.82);
    border-radius: 12px;
    overflow: hidden;
  }
  .hero-main h1 {
    font-size: clamp(2.1rem, 4vw, 3.2rem);
    color: #fff;
  }
  .hero-main img {
    aspect-ratio: 4 / 3;
  }
  .hero-text {
    padding: 20px;
    align-self: center;
  }
  .hero-kicker {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-gold);
    margin-bottom: 12px;
  }
  .hero-side {
    position: relative;
    display: grid;
    border-radius: 12px;
    overflow: hidden;
  }
  .hero-side img {
    transition: transform 500ms ease-out;
  }
  .hero-side:hover img {
    transform: scale(1.04);
  }
  .hero-side img {
    aspect-ratio: 16 / 9;
  }
  .hero-side div {
    position: absolute;
    left: 12px;
    right: 12px;
    bottom: 12px;
    padding: 12px 14px;
    background: rgb(255 255 255 / 0.95);
    border-radius: 8px;
  }
  .hero-side h2 {
    font-size: 1.2rem;
  }
  .hero-side p {
    font-size: 0.9rem;
    color: var(--color-muted);
  }
  .hero-side:hover h2 {
    color: var(--color-brand);
  }
  @media (min-width: 768px) {
    .hero {
      grid-template-columns: 2.2fr 1fr;
      grid-template-rows: 1fr 1fr;
      height: 520px;
    }
    .hero-main {
      grid-row: 1 / 3;
      grid-template-columns: 1fr 1.1fr;
    }
    .hero-main img {
      order: 2;
      aspect-ratio: auto;
      min-height: 0;
    }
    .hero-text {
      padding: 48px;
    }
    .hero-side {
      min-height: 0;
    }
    .hero-side img {
      aspect-ratio: auto;
      min-height: 0;
    }
  }

  .trust {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 6px 20px;
    margin-top: 20px;
    padding: 16px 0;
    border-block: 1px solid var(--color-line);
    font-size: 0.92rem;
    color: var(--color-muted);
  }
  .trust b {
    display: block;
    color: var(--color-ink);
  }
  @media (min-width: 900px) {
    .trust {
      grid-template-columns: repeat(4, 1fr);
      padding: 18px 0;
    }
  }

  .cat {
    display: block;
    text-align: center;
  }
  .cat img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: 50%;
    transition: transform 300ms ease-out;
  }
  .cat:hover img {
    transform: scale(1.05);
  }
  .cat span {
    display: block;
    margin-top: 12px;
    font-weight: 700;
    line-height: 1.25;
  }
  .cat:hover span {
    color: var(--color-brand);
  }

  .promo {
    display: grid;
    background: var(--color-cream);
    border: 1px solid var(--color-line);
    border-radius: 12px;
    overflow: hidden;
  }
  .promo img {
    width: 100%;
    height: 100%;
    max-height: 260px;
    object-fit: cover;
  }
  .promo > div {
    padding: 22px;
    align-self: center;
  }
  .promo h2 {
    font-size: clamp(1.5rem, 2.6vw, 2.1rem);
  }
  .promo-tag {
    font-weight: 700;
    font-size: 0.95rem;
    color: var(--color-copper);
    margin-bottom: 8px;
  }
  .promo p:not(.promo-tag) {
    color: var(--color-muted);
  }

  .honey {
    background: var(--color-night);
    color: #fff;
  }
  .honey-inner {
    display: grid;
    gap: 32px;
    align-items: center;
    padding-block: clamp(40px, 6vw, 72px);
  }
  .honey-label {
    width: min(100%, 420px);
    height: auto;
    margin-inline: auto;
  }
  .honey h2 {
    color: #fff;
  }
  .honey-prices {
    display: flex;
    gap: 32px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid rgb(255 255 255 / 0.15);
  }
  .honey-prices dt {
    font-size: 0.9rem;
    color: rgb(255 255 255 / 0.6);
  }
  .honey-prices dd {
    font-size: 1.4rem;
    font-weight: 800;
    color: var(--color-gold);
  }
  .btn-ghost {
    background: transparent;
    border-color: rgb(255 255 255 / 0.35);
    color: #fff;
  }
  .btn-ghost:hover {
    background: rgb(255 255 255 / 0.08);
    border-color: #fff;
  }
  @media (min-width: 768px) {
    .honey-inner {
      grid-template-columns: 1fr 1.1fr;
      gap: 64px;
    }
  }
  @media (min-width: 768px) {
    .promo {
      grid-template-columns: 340px 1fr;
    }
    .promo > div {
      padding: 28px 36px;
    }
  }

  .edu,
  .story {
    display: grid;
    gap: 28px;
  }
  .edu-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .edu-photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 14px;
  }
  .edu-photos img:first-child {
    grid-column: 1 / 3;
    aspect-ratio: 16 / 10;
  }
  .edu-photos img:not(:first-child) {
    aspect-ratio: 4 / 3;
  }
  .edu-table {
    width: 100%;
    margin-top: 16px;
    border-collapse: collapse;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    font-size: 0.95rem;
  }
  .edu-table th,
  .edu-table td {
    padding: 9px 12px;
    text-align: left;
    border-bottom: 1px solid var(--color-line);
  }
  .edu-table td {
    white-space: nowrap;
    color: var(--color-muted);
  }
  .story img {
    width: 100%;
    border-radius: var(--radius-ui);
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  @media (min-width: 900px) {
    .edu {
      grid-template-columns: 1fr 1.05fr;
      gap: 44px;
      align-items: center;
    }
    .story {
      grid-template-columns: 1fr 1.2fr;
      gap: 44px;
      align-items: center;
    }
  }
</style>
